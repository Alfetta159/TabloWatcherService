[Unit]
Description=TabloWatcherService
After=network.target

[Service]
Type=notify
WorkingDirectory=/opt/tablowatcherservice
# Self-contained publish: a native apphost binary, no `dotnet` runtime needed on the machine.
ExecStart=/opt/tablowatcherservice/TabloWatcherService.Api
Restart=on-failure
RestartSec=5
User=tablowatcher
Environment=ASPNETCORE_ENVIRONMENT=Production
# Port 80, so browsers need no port: http://<host>.local/ (see README). Binding a port below
# 1024 normally takes root; this grants the unprivileged service user just that one
# capability, and the bounding set keeps it from ever gaining any other. "*" listens on
# IPv6 as well as IPv4 - a .local name often resolves to IPv6 first.
Environment=Kestrel__Endpoints__Http__Url=http://*:80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
