<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Local builds are "0.1.0-dev"; packaging/build-packages.sh (and so the release
         workflow) sets the whole version from the tag with -p:Version, e.g. 0.1.0-preview9.
         GET /api/version reports it, and the SPA is built with the same one (see BuildSpa) so
         it can tell when it's talking to a server from a different build. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Refit" Version="16.0.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="16.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime state and dev caches the app writes next to itself (see BlockedTagsStore,
         KeywordRulesStore, DevCache). Never publish this machine's copies - a package upgrade
         would overwrite the installed state with them. -->
    <Content Remove="blocked-tags.json;keyword-recordings.json;dev-guide-cache.json;dev-recordings-cache.json" />
  </ItemGroup>

  <PropertyGroup>
    <SpaRoot>..\tablowatcher-web\</SpaRoot>
    <SpaProxyServerUrl>http://localhost:5173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
  </PropertyGroup>

  <!-- Builds the React SPA and drops it into wwwroot so `dotnet publish` produces a
       single self-contained deployable (API + SPA). Skipped for local `dotnet build`/`dotnet run`
       during frontend development, where `npm run dev` (Vite) is faster to iterate against
       (_IsPublishing is set by the `dotnet publish` command).
       Runs before the build, not after ComputeFilesToPublish: the static web assets list is
       taken from wwwroot during the build, and Vite empties wwwroot and writes new hashed
       file names, so building the SPA any later leaves publish trying to copy files that are
       gone (MSB3030) on the first publish after every frontend change. The wwwroot Content
       glob is evaluated before any target runs, so it's re-read here to pick up the new files. -->
  <Target Name="BuildSpa" BeforeTargets="BeforeBuild" Condition="'$(_IsPublishing)' == 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" EnvironmentVariables="VITE_APP_VERSION=$(Version)" />
    <ItemGroup>
      <!-- By item, not by glob: a glob here only matches what's on disk now, missing the
           files Vite just deleted. -->
      <_OldSpaFile Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').StartsWith('wwwroot'))" />
      <Content Remove="@(_OldSpaFile)" />
      <Content Include="wwwroot\**" ExcludeFromSingleFile="true" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
