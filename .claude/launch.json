{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tablowatcher-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/TabloWatcherService.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5080
    },
    {
      "name": "tablowatcher-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "src/tablowatcher-web",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
